{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "react-jsx",
    "types": [
      "chrome",
      "vite/client"
    ],
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "src",
    "test",
    "vite.config.ts",
    "vitest.config.ts"
  ]
}